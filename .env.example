# bacain_chatbot — Discord link-analysis bot
# Copy to .env and fill in secrets.

# --- required secrets ---
DISCORD_TOKEN=
TINYFISH_API_KEY=
EXA_API_KEY=
LLM_API_BASE=https://ollama.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash:0731
# Optional secondary LLM provider — tried when the primary fails (429/5xx/timeout).
# Leave all three empty to disable fallback.
LLM_FALLBACK_API_BASE=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

# --- gates ---
ANALYZE_CHANNELS=*            # comma-separated channel IDs, or * for all
                              # live: 406720260021157892 (Personal Hermes #general),
                              # 1479875017054490646 + 1479879035919011910 (Forum Rangkai)
COOLDOWN_SECS=60

# --- SQLite store (ticket #4) ---
# Path to the telemetry/dedupe/cooldown database. Default: data/linkbot.db
# (relative to CWD). In Docker the compose file pins this to /data/linkbot.db,
# backed by the named volume `linkbot-data` (rootfs is read-only).
DB_PATH=data/linkbot.db
CACHE_TTL_HOURS=24            # same URL analyzed within this window is a dedupe hit
RETENTION_DAYS=30             # analyses older than this are pruned on write/open

# --- loop policy (env wins over optimized_policy.json) ---
INITIAL_K=5
EXPANSION_K=3
COVERAGE_TARGET=0.85
MIN_NEW_ARTICLES=1
MAX_ROUNDS=3
SEARCH_BUDGET=15

# --- misc ---
CORPUS_TOKEN_BUDGET=60000
REPLY_MODE=thread             # thread | split
RUST_LOG=info
# OPTIMIZED_POLICY_JSON=optimized_policy.json   # loaded at startup if present
ANALYSIS_DEADLINE_SECS=180
